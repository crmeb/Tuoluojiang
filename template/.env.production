# 仅 VITE_ 前缀的变量会被注入客户端；业务代码统一从 @/config/env 取值

# base api
VITE_BASE_API = ''
# socket 连接地址
VITE_WS_URL = ''
# AI 服务地址，留空则回落到接口地址 / 当前 origin
VITE_AI_BASE_URL = ''
# 演示站悬浮客服开关（'true' 开启，其它值关闭；演示站打包用 pnpm run build:demo）
VITE_DEMO_SUPPORT = 'false'
# 演示站登录页预填账号密码，仅 build:demo 时由命令行注入，正式包保持为空
VITE_DEMO_ACCOUNT = ''
VITE_DEMO_PASSWORD = ''
