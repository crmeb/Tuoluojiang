{
  // ---- ESLint：只做实时提示，不参与 dev / build ----
  "eslint.useFlatConfig": true,
  "eslint.validate": ["javascript", "javascriptreact", "typescript", "typescriptreact", "vue"],
  "eslint.run": "onType",

  // ---- TypeScript：必须用项目内的 TS 版本，否则 Volar 对 Vue 2.7 的解析会走偏 ----
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,

  // ---- 不使用格式化工具 ----
  // 项目没有统一的 formatter，格式由人工把控。保存时自动格式化会按编辑器
  // 内置规则重排存量文件，制造大量无关 diff，所以关掉。
  "editor.formatOnSave": false,

  // ---- 让 @/ 别名跳转、自动导入走 tsconfig 的 paths ----
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",

  // 行尾不在这里强制：仓库 core.autocrlf=true，由 git 负责规范化
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true
  }
}
