{
  // 混编约定：存量 .js / .vue(js) 只做「允许被引用」，不做类型检查（checkJs: false）；
  // 新写的 .ts / .tsx / <script lang="ts"> 才走完整 strict 校验。
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "jsxFactory": "h",

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    // 只做类型检查，产物一律由 Vite/esbuild 生成
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // 存量 js 互操作
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    // Vue 2.7 基于 defineProperty，类字段必须是 [[Set]] 语义
    "useDefineForClassFields": false,

    // 不设 baseUrl：TS 6 起它已弃用，paths 会相对本文件所在目录解析，语义等价
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },

  // Volar 需要显式声明目标是 Vue 2.7，否则按 Vue 3 模板语义编译
  "vueCompilerOptions": {
    "target": 2.7
  },

  "include": [
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "build/**/*.ts",
    "vite.config.ts",
    "eslint.config.ts"
  ],
  "exclude": ["node_modules", "dist", "src/assets", "src/views/business/components/formSetting"]
}
