# Docker 基线配置（开源目录独立实例，勿与 oa-complete 的 tuoluojiang/#1 共用）
# 端口/实例名冲突时由 manage.sh 自动递增，写入 .docker.instance.env
# 日常只需: ./manage.sh start  或  ./manage.sh start --new

# MySQL/Redis 宿主机发布地址：默认 127.0.0.1（本机/SSH 隧道可连，公网不可达）
# 仅在可信内网确需直连时改为 0.0.0.0（不推荐上公网）
HOST_PUBLISH_BIND=127.0.0.1
# 独立镜像名，避免 --build 覆盖商业版 tuoluojiang-php:ocr
# PHP 镜像构建目标：ocr=完整知识库 OCR（默认）；base=轻量（仅 poppler，无 tesseract）

TZ=Asia/Shanghai

PHP_VERSION=8.0
PHP_MEMORY_LIMIT=512M
PHP_MAX_EXECUTION_TIME=300
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_POST_MAX_SIZE=108M

MYSQL_ROOT_PASSWORD=123456
MYSQL_DATABASE=tuoluojiang
MYSQL_USER=tuoluojiang
MYSQL_PASSWORD=123456
MYSQL_PORT=3306
MYSQL_ROOT_HOST=%

REDIS_PORT=6379
REDIS_PASSWORD=

APP_PORT=20200
APP_ENV=local
APP_DEBUG=true

# ----- 自动分配的实例（由 manage.sh 生成） -----
INSTANCE_INDEX=1
INSTANCE_NAME=tuoluojiang-open
COMPOSE_PROJECT_NAME=tuoluojiang-open
HOST_APP_PORT=20400
HOST_MYSQL_PORT=3476
HOST_REDIS_PORT=6489
REDIS_DATA_PATH=./redis/data
MYSQL_LOG_PATH=./mysql/logs
MYSQL_DATA_VOLUME=./mysql/data
MYSQL_LOG_VOLUME=./mysql/logs
REDIS_DATA_VOLUME=./redis/data
PHP_IMAGE_NAME=tuoluojiang-open-php
PHP_IMAGE_TARGET=ocr
