# ---------- 知识库 RAG（config/knowledge.php） ----------
# 向量索引 Redis DB（RediSearch 仅支持 DB 0，请保持 0）
REDIS_KNOWLEDGE_DB=0
# 向量检索驱动: auto|redis|mysql（auto/redis 需 Redis Stack）
KNOWLEDGE_VECTOR_DRIVER=auto
# 语义/结构切片（入库阶段；默认关闭，走 legacy 固定长度切片）
KNOWLEDGE_FEATURE_SEMANTIC_CHUNK=false
# 查询改写（需配置 KNOWLEDGE_REWRITE_MODEL_ID；默认关闭）
KNOWLEDGE_FEATURE_QUERY_REWRITE=false
# 精排 rerank（需配置 KNOWLEDGE_RERANK_MODEL_ID；默认关闭；开启后粗排用 KNOWLEDGE_COARSE_TOP_N）
KNOWLEDGE_FEATURE_RERANK=false
# 强化 Prompt：资料不足拒答 + 结论/依据/[n] 引用（默认 true）
KNOWLEDGE_FEATURE_STRICT_PROMPT=true
# 事后事实校验（预留，默认关闭）
KNOWLEDGE_FEATURE_FACT_CHECK=false
KNOWLEDGE_COARSE_TOP_N=40
KNOWLEDGE_RERANK_TOP_K=5
KNOWLEDGE_REWRITE_MODEL_ID=0
KNOWLEDGE_REWRITE_TIMEOUT_MS=3000
KNOWLEDGE_RERANK_MODEL_ID=0
KNOWLEDGE_RERANK_TIMEOUT_MS=5000
